created_files = []

while True:
    print("\nChoose an action:")
    print("1. Create a file and write text (Max: 3 files)")
    print("2. Read the contents of a file")
    print("3. Show all created files")
    print("4. Exit")

    choice = input("Enter your choice (1-4): ")

    if choice == "1":
        if len(created_files) > 3:
            print("You can only create up to 3 files.")
        else:
            filename = input("Enter the name of the file to create: ")

            if filename in created_files:
                print("This file already exists. Try another name.")
            
            else:
                content = input("What do you want to write in the file? ")

                with open(filename, "w") as file:
                    file.write(content)
                created_files.append(filename)
                print(f"File '{filename}' has been created!")

    elif choice == "2":
        filename = input("Enter the name of the file to read: ")

        if filename in created_files:
            with open(filename, "r") as file:
                print("\nFile Contents:")
                print(file.read())
        else:
            print("The file does not exist. Please create it first.")

    elif choice == "3":
        if created_files:
            print("\nAll created files:")
            for file in created_files:
                print(f"- {file}")
        else:
            print("No files have been created yet.")

    elif choice == "4":
        print("Goodbye!")
        break 

    else:
        print("Invalid choice. Please choose 1, 2, 3, or 4.")
