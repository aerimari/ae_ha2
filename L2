print("Welcome to the String Manipulator!")

while True:
    text = input("Enter a word or phrase: ")
    print("\nWhat would you like to do with it?")
    print("1. Convert to uppercase")
    print("2. Convert to lowercase")
    print("3. Count the number of characters")
    print("4. Replace a word")
    print("5. Exit")

    choice = input("Enter your choice (1-5): ")

    if choice == "1":
        print("Uppercase:", text.upper())
    elif choice == "2":
        print("Lowercase:", text.lower())
    elif choice == "3":
        print("Number of characters:", len(text))
    elif choice == "4":
        old_word = input("Enter the word to replace: ")
        new_word = input("Enter the new word: ")
        print("Updated text:", text.replace(old_word, new_word))
    elif choice == "5":
        print("Thanks for using the String Manipulator! Goodbye!")
        break
    else:
        print("Invalid choice. Please try again.")
