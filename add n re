print("Welcome to the shopping list")

shop_list = []
while True:
    print("1. Add item")
    print("2. View list")
    print("3. Remove item")
    print("4. Exit")
    
    option = input("What would you like to do? (1-4): ")
    
    if option == "1":
        item = input("Enter an item to add: ")
        shop_list.append(item) 
        print(f"{item} has been added to the shopping list.")
    elif option == "2":
        print("Your shopping list:")
        if shop_list:
            for item in shop_list:
                print(f"- {item}")
        else:
            print("Your shopping list is empty.")
    elif option == "3":
        remove = input("Enter the name of the item to remove: ")
        if remove in shop_list:
            shop_list.remove(remove)
            print(f"{remove} has been removed from the shopping list.")
        else:
            print(f"{remove} is not in the shopping list.")
    elif option == "4":
        print("Thanks for using the shopping list.")
        break
    else:
        print("Invalid choice. Please select a valid option.")
